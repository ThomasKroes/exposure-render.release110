# Source is LF in the repository and in the working tree.
*.cpp   text eol=lf
*.h     text eol=lf
*.cu    text eol=lf
*.cuh   text eol=lf
*.txt   text eol=lf
*.xml   text eol=lf
*.qrc   text eol=lf
*.py    text eol=lf
*.md    text eol=lf

# Volume data and icons are binary; never touch them.
*.raw   binary
*.mhd   binary
*.png   binary
